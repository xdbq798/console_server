# 开发环境：复制为 .env.dev，也兼容原有 .env。
DATABASE_URL=postgresql+asyncpg://user:password@localhost/console_dev
DEBUG=true
ENV=dev
PORT=8000
COOKIE_SECURE=false
CORS_ALLOW_ORIGIN="http://localhost:5173;http://localhost:8000"

# 使用 python -c "import secrets; print(secrets.token_urlsafe(64))" 生成环境独立密钥
SECRET_KEY=

# Redis（token 黑名单快速路径等；留空 = 禁用并降级为数据库路径）
REDIS_URL=redis://localhost:6379/0

# 日志（loguru 统一日志；不配置时全局默认 INFO、彩色文本输出）
# GLOBAL_LOG_LEVEL=INFO
# 可按模块单独覆盖：CONFIG_LOG_LEVEL / DB_LOG_LEVEL / MAIN_LOG_LEVEL / SOCKET_LOG_LEVEL / OAUTH_LOG_LEVEL
# LOG_FORMAT=json  # 生产或日志集中采集时启用结构化 JSON 输出

# AI 对话（仅后端读取；未配置时其他功能仍可使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_READ_TIMEOUT_SECONDS=60
CHAT_STREAM_TIMEOUT_SECONDS=300
