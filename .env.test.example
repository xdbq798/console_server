# 测试环境：复制为 .env.test，并替换数据库连接及填写独立的 SECRET_KEY。
DATABASE_URL=postgresql+asyncpg://user:password@test-db/console_test
SECRET_KEY=
DEBUG=false
RELOAD=false
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info
COOKIE_SECURE=false
# 通过反向代理部署时，填写实际代理 IP / 网段。
FORWARDED_ALLOW_IPS=127.0.0.1
ENV=test
# Redis（token 黑名单快速路径等；留空 = 禁用并降级为数据库路径）
# 部署 compose 已内置 redis 服务（主机名 redis）；REDIS_URL 中的密码与 REDIS_PASSWORD 需保持一致。
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# AI 对话（仅后端读取；未配置时其他功能仍可使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_READ_TIMEOUT_SECONDS=60
CHAT_STREAM_TIMEOUT_SECONDS=300
